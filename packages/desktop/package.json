{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/desktop",
  "version": "0.1.0",
  "description": "The safe defaults of the main process of an Electron app: the content security policy, sandboxed windows, navigation rules, no permissions or downloads, the app:// scheme and IPC checks.",
  "keywords": [
    "electron",
    "desktop",
    "security",
    "content-security-policy",
    "sandbox",
    "context-isolation",
    "navigation",
    "protocol",
    "ipc",
    "typescript"
  ],
  "homepage": "https://github.com/mark1russell7/desktop/tree/main/packages/desktop#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/desktop/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/desktop.git",
    "directory": "packages/desktop"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "import": "./build/index.js",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/files": "^0.0.3"
  },
  "peerDependencies": {
    "electron": ">=45.0.0"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "^45.2.3",
    "esbuild": "^0.28.2",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
